# Dependencies
node_modules/

# Build output — regenerated by `npm run build`, never committed
dist/
*.tgz

# Expo / React Native
.expo/
.expo-shared/
# Native projects are generated by `expo prebuild`; the config in app.json is
# the source of truth, so a checked-in copy only goes stale.
example/ios/
example/android/
*.jsbundle

# Metro / bundler caches
.metro-health-check*
haste-map-*

# Test and tooling output
coverage/
*.log
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
