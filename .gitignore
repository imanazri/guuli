# Dependencies
node_modules/

# Build output. Committed deliberately so `npm install github:imanazri/guuli`
# works without a build step; the `prepare` script keeps it current. tsup is
# deterministic and emits no absolute paths, so rebuilding produces identical
# bytes and does not dirty the tree.
*.tgz

# Expo / React Native
.expo/
.expo-shared/
*.jsbundle

# Local demo app. Useful for checking rendering on a device, but it is a
# harness, not part of the package — the `files` allowlist never shipped it.
example/

# Metro / bundler caches
.metro-health-check*
haste-map-*

# Test and tooling output
coverage/
*.log
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
