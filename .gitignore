# Dependencies
node_modules/

# Build output — regenerated by `npm run build`, never committed
dist/
*.tgz

# Expo / React Native
.expo/
.expo-shared/
*.jsbundle

# Local demo app. Useful for checking rendering on a device, but it is a
# harness, not part of the package — the `files` allowlist never shipped it.
example/

# Metro / bundler caches
.metro-health-check*
haste-map-*

# Test and tooling output
coverage/
*.log
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
